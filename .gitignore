# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Local settings / secrets - never commit
.env
.env.*

# Temporary uploads, session data and generated PDFs
# (the app writes these to the system temp folder; these patterns are a safety net)
/tmp/
/uploads/
/outputs/
/sessions/
/mch-pdf-organizer-tmp/
/*.pdf
/*.docx
/*.xlsx

# Generated by tests (tests/fixtures/ IS committed: small synthetic files only)
/fixtures/
/e2e-out/
*.log

# Editors / OS
.vscode/
.idea/
node_modules/
.DS_Store
Thumbs.db
